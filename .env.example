# Safe local development defaults
APP_NAME=InfraWatch
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=info
INFRAWATCH_SERVICES_CONFIG=config/services.yaml
INFRAWATCH_LOG_PATH=logs/app.log
INFRAWATCH_DISK_PATH=/
INFRAWATCH_CPU_INTERVAL=0.1
INFRAWATCH_BIND_ADDRESS=127.0.0.1
INFRAWATCH_API_PORT=8000
INFRAWATCH_PROMETHEUS_PORT=9090
INFRAWATCH_GRAFANA_PORT=3000
# Local-only Grafana defaults. Change before any nonlocal deployment.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-local-only
INFRAWATCH_RECOVERY_DRY_RUN=true
INFRAWATCH_DOCKER_RECOVERY_ENABLED=false
# Comma-separated exact container names, used only when Docker recovery is explicitly enabled.
INFRAWATCH_RECOVERY_ALLOWED_CONTAINERS=
INFRAWATCH_RECOVERY_WORKER_URL=http://recovery-worker:8090
INFRAWATCH_RECOVERY_WORKER_TOKEN=replace-with-random-token-at-least-16-chars
